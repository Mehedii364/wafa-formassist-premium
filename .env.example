# APP_URL: Public URL where WAFA FormAssist is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# PORT: HTTP server listening port (default: 3000)
PORT="3000"

# NODE_ENV: "development" or "production"
NODE_ENV="development"

# Cloud SQL (PostgreSQL) connection settings (optional; offline mode works without cloud DB).
# Provisioned automatically when Cloud SQL is enabled in AI Studio.
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""

# CORS allowlist: comma-separated list of trusted origins allowed to send credentials.
# Example: ALLOWED_ORIGINS="https://app.example.com,chrome-extension://<extension-id>"
ALLOWED_ORIGINS=""

# Set to "true" ONLY when running behind a trusted reverse proxy (e.g., Cloud Run / Nginx).
TRUST_PROXY="false"

# Authenticated cloud session idle expiration in minutes (default: 120).
SESSION_IDLE_MINUTES="120"
